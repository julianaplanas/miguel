# --- Autenticacion (usuario unico) ---
APP_USERNAME=miguel
APP_PASSWORD=cambia-esta-clave
SECRET_KEY=genera-uno-largo-y-aleatorio
SESSION_MAX_AGE=604800

# --- OpenRouter (chat) ---
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_TITLE=Gastos Dashboard

# --- Datos ---
# Carpeta de datos (base SQLite + archivos subidos).
#
# NO la definas en Railway: con un volumen creado, la app usa sola su ruta
# de montaje. Si la defines con un valor relativo como ./data, los datos
# terminan dentro del contenedor (/app/data), fuera del volumen, y se
# borran en cada deploy.
#
# Solo tiene sentido en local, o para forzar una ruta absoluta concreta.
# DATA_DIR=./data
# Opcional: si usas Postgres de Railway se toma DATABASE_URL automaticamente
# DATABASE_URL=postgresql://...
# Moneda base: en la que se muestran los totales y a la que se convierte
# cuando hay varias monedas mezcladas.
CURRENCY=ARS
LOCALE=es-AR
